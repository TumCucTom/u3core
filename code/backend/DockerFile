# Use the Node.js image
FROM node:16

# Set the working directory
WORKDIR /usr/src/app

# Copy package.json and package-lock.json
COPY web-server/package*.json ./

# Install dependencies
RUN npm install

# Copy the backend code
COPY web-server .

# Expose the backend port
EXPOSE 3000

# Start the backend
CMD ["node", "app.js"]
